# Database configuration for the Number Guessing Game web server
# Copy this file to .env and adjust values as needed

# PostgreSQL credentials (centralized configuration)
POSTGRES_USER=numberguess
POSTGRES_PASSWORD=password
POSTGRES_DB=numberguess_dev

# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database
# Note: docker-compose.yml and make/just commands use the variables above
DATABASE_URL=postgresql://numberguess:password@localhost:5432/numberguess_dev

# Maximum number of database connections in the pool
# Valid range: 1-100 (default: 5)
DB_MAX_CONNECTIONS=5

# Logging configuration
# Controls the verbosity of application logs using the tracing framework
# Format: RUST_LOG=target[=level][,target[=level]]
# Levels: trace, debug, info, warn, error (default: info)
#
# Examples:
# RUST_LOG=info                              # Show info level and above for all modules
# RUST_LOG=debug                             # Show debug level and above for all modules
# RUST_LOG=number_guessing_game=debug        # Debug level for this app only
# RUST_LOG=number_guessing_game::web=trace   # Trace level for web module only
# RUST_LOG=sqlx=warn,number_guessing_game=debug  # Multiple module settings
RUST_LOG=number_guessing_game=info

# OAuth2/OIDC Configuration
# These secrets are used by oauth2-proxy for session encryption and Keycloak client authentication
# Generate new secrets for production use!
#
# Generate cookie secret (32 bytes, base64-encoded):
# python3 -c 'import os,base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())'
OAUTH2_COOKIE_SECRET=CHANGE_ME_GENERATE_32_BYTE_SECRET

# Generate client secret (random alphanumeric):
# python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
OAUTH2_CLIENT_SECRET=CHANGE_ME_GENERATE_CLIENT_SECRET

# Notes:
# - This DATABASE_URL is only needed for web server mode (--server flag)
# - CLI mode does not require a database
# - The docker-compose setup uses these credentials by default
# - For local development, you can use docker-compose to start the full stack:
#   make dev  (starts postgres, redis, keycloak, oauth2-proxy, and app)
# - Authentication is handled by oauth2-proxy with Keycloak as the identity provider
# - Test user: admin@local.test (password: password)
