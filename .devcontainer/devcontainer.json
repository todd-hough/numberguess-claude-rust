{
  "name": "numberguess-dev",
  "image": "mcr.microsoft.com/devcontainers/rust:1-bullseye",
  "workspaceFolder": "/workspaces/numberguess-claude-rust",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/numberguess-claude-rust,type=bind,consistency=cached",
  "runArgs": ["--init", "--privileged"],
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "moby": "true"
    }
  },
  "containerEnv": {
    "INSIDE_DEVCONTAINER": "1"
  },
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y postgresql-client curl pkg-config libssl-dev && rustup component add clippy rustfmt && cargo fetch",
  "customizations": {
    "vscode": {
      "settings": {
        "rust-analyzer.cargo.features": "all",
        "editor.formatOnSave": true
      },
      "extensions": [
        "rust-lang.rust-analyzer",
        "vadimcn.vscode-lldb"
      ]
    }
  }
}
